# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Backend Render usado pelo frontend publicado no GitHub Pages.
VITE_API_BASE_URL="https://SEU-SERVICO.onrender.com"
# Origem exata do frontend, sem barra final. Pode conter várias origens separadas por vírgula.
FRONTEND_URL="https://SEU_USUARIO.github.io/BingouPix"
# Obrigatório no Render: monte um Persistent Disk em /var/data; sem o disco, saldo/perfis e segredo de sessão se perdem em reinícios. Mantenha este valor.
BINGO_DATA_DIR="/var/data"

# Mercado Pago: configure estes valores somente no ambiente do servidor/deploy.
# Desenvolvimento usa token TEST-; produção usa APP_USR- mais a chave Ed25519 abaixo.
# Nunca coloque Access Token, Client Secret ou webhook secret no frontend, .env público ou Git.
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-..."
# Chave privada Ed25519 usada para assinar o body dos payouts; cadastre a chave pública da dupla no Mercado Pago.
# Configure como secret no Render; nunca commite a chave real. O serviço Payouts deve estar habilitado pela conta.
MERCADO_PAGO_PAYOUT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Chave secreta gerada no painel Mercado Pago > Webhooks.
MERCADO_PAGO_WEBHOOK_SECRET="..."
# URL pública HTTPS a cadastrar no painel: https://SEU_DOMINIO/api/webhooks/mercado-pago
# A chave pública pode ser exposta no frontend, se o SDK for usado futuramente.
VITE_MERCADO_PAGO_PUBLIC_KEY="APP_USR-..."
